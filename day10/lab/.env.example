# Day 10 Lab — copy thành .env và điền nếu cần
#   cp .env.example .env

# ChromaDB (khuyến nghị tách collection khỏi Day 09)
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=day10_kb

# Embedding (SentenceTransformers — offline)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Freshness SLA (giờ)
FRESHNESS_SLA_HOURS=720
FRESHNESS_DATA_SLA_HOURS=720
FRESHNESS_PIPELINE_SLA_HOURS=2
# Căn exported_at snapshot cũ về wall-clock ingest/publish (mặc định bật)
# Demo Sprint 3 inject — mặc định TẮT; chỉ bật khi chạy inject corruption
ALLOW_SKIP_VALIDATE=0

# Tuỳ chọn: OpenAI chỉ cần nếu nhóm mở rộng eval bằng LLM-judge
# OPENAI_API_KEY=
